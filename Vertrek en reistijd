        <div class="kop-sub">Vanaf kantoor Halfweg</div>
      </div>
    </div>
    <div class="a-lijst" id="a-lijst"></div>
    <div class="voet"><span class="stxt" id="a-status">Opstarten…</span></div>
  </section>

</div>

<script>
// ╔════════════════════════════════════════════════════════════════╗
// ║  CONFIGURATIE                                                  ║
// ║  Route A (aanbevolen), via de Yodeck-URL:                      ║
// ║    ...bestand.html?nsapikey=NS_SLEUTEL&apikey=TOMTOM_SLEUTEL   ║
// ║  Route B, vast in dit bestand: vervang de twee waarden         ║
// ║    [nog in te vullen] hieronder.                               ║
// ║  Een waarde uit de URL gaat altijd voor.                       ║
// ╚════════════════════════════════════════════════════════════════╝
function urlParam(naam) {
  try { return new URLSearchParams(window.location.search).get(naam) || ''; } catch { return ''; }
}
function geldigeSleutel(k) { return !!k && !String(k).trim().startsWith('['); }

const TREIN = {
  apiSleutel: urlParam('nsapikey') || '8a4e5ff007914724aee958afa0481ea6',
  station:    'HWZB',
  maxRijen:   7,
  verversMs:  60000,
};

const AUTO = {
  apiSleutel: urlParam('apikey') || 'ClQP1K2s2boAjxqkXDN3Vq66rLyl5wSj',
  originLat:  52.3823,
  originLon:  4.7348,
  cacheTtl:   5 * 60 * 1000,
};

const BESTEMMINGEN = [
  { naam: 'Aalsmeer',        lat: 52.25908,  lon: 4.76635  },
  { naam: 'Alkmaar',         lat: 52.63199,  lon: 4.74588  },
  { naam: 'Amersfoort',      lat: 52.15817,  lon: 5.38682  },
  { naam: 'Assendelft',      lat: 52.46965,  lon: 4.74283  },
  { naam: 'Castricum',       lat: 52.55199,  lon: 4.67352  },
  { naam: 'Heemskerk',       lat: 52.51046,  lon: 4.66997  },
  { naam: "'t Kalf",         lat: 52.469008, lon: 4.838422 },
  { naam: 'Jisp',            lat: 52.50788,  lon: 4.84802  },
  { naam: 'Nijkerk',         lat: 52.219967, lon: 5.481498 },
  { naam: 'Raamsdonksveer',  lat: 51.694906, lon: 4.874942 },
  { naam: 'Spijkenisse',     lat: 51.84497,  lon: 4.32903  },
];

/* ══ ALGEMEEN ══ */
const pad = n => String(n).padStart(2, '0');
function nuTekst() { const n = new Date(); return `${pad(n.getHours())}:${pad(n.getMinutes())}`; }
function esc(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function setStatus(id, tekst, modus) {
  const el = document.getElementById(id);
  el.textContent = tekst;
  el.className = 'stxt' + (modus === 'fout' ? ' fout' : '');
}

/* ════════════════════════════════════════════════════════════════
   TREIN
   ════════════════════════════════════════════════════════════════ */
function resterendMs(iso) { return iso ? Math.max(0, new Date(iso) - Date.now()) : null; }
function vertragingMin(p, a) { return (p && a) ? Math.round((new Date(a) - new Date(p)) / 60000) : 0; }

// Boven de minuut aftellen in minuten, daaronder in seconden. Op 0: rood.
function tijdWeergave(ms, vertraagd) {
  if (ms === null) return { getal: '–', eenheid: '', rood: false };
  if (ms <= 0)     return { getal: '0', eenheid: 'min', rood: true };
  if (ms < 60000)  return { getal: Math.ceil(ms / 1000), eenheid: 'sec', rood: vertraagd };
  return { getal: Math.floor(ms / 60000), eenheid: 'min', rood: vertraagd };
}

function treinLaden() {
  document.getElementById('t-lijst').innerHTML = Array(TREIN.maxRijen).fill(0).map(() => `
    <div class="t-rij">
      <div class="cell-dir"><div class="dir-naam">Bezig met laden…</div></div>
      <div class="laden-punt"></div>
    </div>`).join('');
}

function treinRender(lijst) {
  const el = document.getElementById('t-lijst');
  if (!lijst || !lijst.length) {
    el.innerHTML = `<div class="t-rij"><div class="cell-dir"><div class="dir-naam">Geen vertrektijden beschikbaar</div></div></div>`;
    return;
  }
  el.innerHTML = lijst.slice(0, TREIN.maxRijen).map(dep => {
    const can = !!dep.cancelled;
    const del = vertragingMin(dep.plannedDateTime, dep.actualDateTime);
    const trk = String(dep.actualTrack || dep.plannedTrack || '–').toUpperCase();
    const iso = dep.actualDateTime || dep.plannedDateTime || '';
    const status = can
      ? `<div class="dir-status rijdt-niet">Rijdt niet</div>`
      : (del >= 1 ? `<div class="dir-status">${del} min later</div>` : '');
    return `
      <div class="t-rij ${can ? 'x' : ''}" data-vertrek="${esc(iso)}" data-vertraagd="${del >= 1 ? '1' : '0'}" data-geannuleerd="${can ? '1' : '0'}">
        <div class="cell-dir">
          <div class="dir-naam-wrap"><div class="dir-naam${can ? ' geannuleerd' : ''}">${esc(dep.direction || '–')}</div></div>
          ${status}
        </div>
        <div class="cell-spoor"><span class="spoor-chip">${esc(trk)}</span></div>
        <div class="cell-tijd"><span class="tijd-nu">–</span><span class="tijd-unit"></span></div>
      </div>`;
  }).join('');

  requestAnimationFrame(zetScrollAan);
  planScrollCheck();
  treinTik();
}

// Elke seconde alleen de "over"-kolom bijwerken, zodat de scroll van
// lange plaatsnamen niet steeds opnieuw begint.
function treinTik() {
  document.querySelectorAll('.t-rij[data-vertrek]').forEach(rij => {
    const cijfer = rij.querySelector('.tijd-nu');
    const eenheid = rij.querySelector('.tijd-unit');
    if (rij.dataset.geannuleerd === '1') {
      cijfer.textContent = '–';
      cijfer.className = 'tijd-nu geannuleerd';
      eenheid.textContent = '';
      return;
    }
    const w = tijdWeergave(resterendMs(rij.dataset.vertrek), rij.dataset.vertraagd === '1');
    cijfer.textContent = w.getal;
    cijfer.className = 'tijd-nu' + (w.rood ? ' vertraagd' : '');
    eenheid.textContent = w.eenheid;
  });
}

// Scroll van lange richtingsnamen, aangedreven met requestAnimationFrame
// (betrouwbaarder in de Yodeck-browser dan CSS-keyframes).
let scrollItems = [];
let scrollLoopt = false;

function planScrollCheck() {
  const opnieuw = () => requestAnimationFrame(() => requestAnimationFrame(zetScrollAan));
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(opnieuw).catch(opnieuw);
  else opnieuw();
  setTimeout(zetScrollAan, 500);
}

function zetScrollAan() {
  scrollItems = [];
  document.querySelectorAll('.dir-naam-wrap').forEach(wrap => {
    const naam = wrap.querySelector('.dir-naam');
    naam.style.transform = 'translateX(0)';
    const tekstBreedte = naam.scrollWidth;
    if (tekstBreedte - wrap.clientWidth > 4) {
      const pauzeMs = 5000;
      const reisMs = Math.max(2000, (tekstBreedte / 55) * 1000);
      scrollItems.push({ el: naam, tekstBreedte, pauzeMs, reisMs, cycleMs: pauzeMs + reisMs });
    }
  });
  if (!scrollLoopt) { scrollLoopt = true; requestAnimationFrame(scrollFrame); }
}

function scrollFrame(now) {
  scrollItems.forEach(item => {
    const t = now % item.cycleMs;
    if (t < item.pauzeMs) item.el.style.transform = 'translateX(0)';
    else {
      const v = (t - item.pauzeMs) / item.reisMs;
      item.el.style.transform = `translateX(-${(v * item.tekstBreedte).toFixed(1)}px)`;
    }
  });
  requestAnimationFrame(scrollFrame);
}

async function treinOphalen() {
  if (!geldigeSleutel(TREIN.apiSleutel)) {
    setStatus('t-status', 'Geen NS API-sleutel ingesteld (?nsapikey=... of in de code)', 'fout');
    return;
  }
  const url = `https://gateway.apiportal.ns.nl/reisinformatie-api/api/v2/departures?station=${TREIN.station}&maxJourneys=${TREIN.maxRijen}`;
  try {
    const r = await fetch(url, { headers: { 'Ocp-Apim-Subscription-Key': TREIN.apiSleutel } });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const j = await r.json();
    treinRender(j.payload?.departures || j.departures || []);
    setStatus('t-status', `Laatste update: ${nuTekst()}`, 'ok');
  } catch (e) {
    setStatus('t-status', 'Fout bij ophalen: ' + e.message, 'fout');
  }
}

/* ════════════════════════════════════════════════════════════════
   AUTO
   ════════════════════════════════════════════════════════════════ */
const CACHE_SLEUTEL = 'ai_reistijd_zijbalk_cache_v1';
let autoTimer = null;

function secNaarTekst(sec) {
  const m = Math.round(sec / 60);
  if (m < 60) return `${m} min`;
  const u = Math.floor(m / 60), r = m % 60;
  return r > 0 ? `${u}u${pad(r)}` : `${u}u`;
}

async function haalReistijd(b, poging = 1) {
  const url = `https://api.tomtom.com/routing/1/calculateRoute/${AUTO.originLat},${AUTO.originLon}:${b.lat},${b.lon}/json?key=${encodeURIComponent(AUTO.apiSleutel.trim())}&traffic=true&travelMode=car&computeTravelTimeFor=all`;
  try {
    const res = await fetch(url);
    if (!res.ok) {
      let detail = `HTTP ${res.status}`;
      try { const j = await res.json(); detail = j?.detailedError?.message || j?.error?.description || detail; } catch {}
      const fout = new Error(detail); fout.status = res.status; throw fout;
    }
    const sum = (await res.json()).routes?.[0]?.summary;
    if (!sum) throw new Error('Geen route in antwoord');
    return { ok: true, rijSec: sum.travelTimeInSeconds, normSec: sum.noTrafficTravelTimeInSeconds ?? sum.travelTimeInSeconds };
  } catch (err) {
    const limiet = err.status === 429 || err.status === 403 || /rate limit|quota/i.test(err.message || '');
    if (poging < 3) {
      await new Promise(r => setTimeout(r, limiet ? 4000 * poging : 1800));
      return haalReistijd(b, poging + 1);
    }
    return { ok: false, fout: err.message };
  }
}

async function haalGespreid(lijst, gelijktijdig = 2, pauzeMs = 300) {
  const uit = new Array(lijst.length);
  let volgende = 0;
  async function werker() {
    while (volgende < lijst.length) {
      const k = volgende++;
      uit[k] = await haalReistijd(lijst[k]);
      if (volgende < lijst.length) await new Promise(r => setTimeout(r, pauzeMs));
    }
  }
  await Promise.all(Array.from({ length: Math.min(gelijktijdig, lijst.length) }, werker));
  return uit;
}

function autoLaden() {
  document.getElementById('a-lijst').innerHTML = BESTEMMINGEN.map(b => `
    <div class="a-rij">
      <div class="a-info"><div class="a-naam">${esc(b.naam)}</div></div>
      <div class="laden-punt"></div>
    </div>`).join('');
}

function autoRij(b, r) {
  if (!r || !r.ok) {
    return `<div class="a-rij"><div class="a-info"><div class="a-naam">${esc(b.naam)}</div></div><div class="a-min gr">–</div></div>`;
  }
  const delta = Math.max(0, r.rijSec - r.normSec);
  const rat   = r.normSec > 0 ? r.rijSec / r.normSec : 1;
  const kls   = (rat > 1.4 || delta > 900) ? 'r' : (rat > 1.1 || delta > 180) ? 'o' : 'g';
  const dMin  = Math.round(delta / 60);
  const plus  = dMin > 0 ? `<span class="a-plus">+${dMin} min</span>` : '';
  return `<div class="a-rij ${kls}">
      <div class="a-info"><div class="a-naam">${esc(b.naam)}</div></div>
      <div class="a-min ${kls}">${esc(secNaarTekst(r.rijSec))}${plus}</div>
    </div>`;
}

function autoToon(resultaten) {
  document.getElementById('a-lijst').innerHTML = BESTEMMINGEN.map((b, i) => autoRij(b, resultaten[i])).join('');
}

function laadCache() {
  try {
    const c = JSON.parse(localStorage.getItem(CACHE_SLEUTEL));
    if (c && c.tijdstip && c.resultaten && (Date.now() - c.tijdstip) < AUTO.cacheTtl) return c;
  } catch {}
  return null;
}
function slaCache(resultaten) {
  try { localStorage.setItem(CACHE_SLEUTEL, JSON.stringify({ tijdstip: Date.now(), resultaten })); } catch {}
}

async function autoOphalen() {
  clearTimeout(autoTimer);
  if (!geldigeSleutel(AUTO.apiSleutel)) {
    setStatus('a-status', 'Geen TomTom API-sleutel ingesteld (?apikey=... of in de code)', 'fout');
    return;
  }
  const cache = laadCache();
  if (cache) {
    autoToon(cache.resultaten);
    const t = new Date(cache.tijdstip);
    setStatus('a-status', `Laatste update: ${pad(t.getHours())}:${pad(t.getMinutes())}`, 'ok');
    autoTimer = setTimeout(autoOphalen, AUTO.cacheTtl - (Date.now() - cache.tijdstip));
    return;
  }
  setStatus('a-status', 'Reistijden ophalen…', 'bezig');
  const resultaten = await haalGespreid(BESTEMMINGEN);
  slaCache(resultaten);
  autoToon(resultaten);
  setStatus('a-status', `Laatste update: ${nuTekst()}`, 'ok');
  autoTimer = setTimeout(autoOphalen, AUTO.cacheTtl);
}

/* ══ KLOK BOVENBALK ══ */
const DAGEN   = ['zondag','maandag','dinsdag','woensdag','donderdag','vrijdag','zaterdag'];
const MAANDEN = ['januari','februari','maart','april','mei','juni','juli','augustus','september','oktober','november','december'];
function klokTik() {
  const n = new Date();
  document.getElementById('klok-tijd').textContent = `${pad(n.getHours())}:${pad(n.getMinutes())}`;
  document.getElementById('klok-datum').textContent = `${DAGEN[n.getDay()]} ${n.getDate()} ${MAANDEN[n.getMonth()]} ${n.getFullYear()}`;
}

/* ══ OPSTART ══ */
window.addEventListener('DOMContentLoaded', () => {
  klokTik();
  setInterval(klokTik, 1000);
  treinLaden();
  autoLaden();
  setStatus('t-status', 'Vertrektijden ophalen…', 'bezig');
  setTimeout(() => {
    treinOphalen();
    setInterval(treinOphalen, TREIN.verversMs);
    setInterval(treinTik, 1000);
  }, 300);
  // Auto iets later starten, zodat beide API's niet tegelijk aanvragen doen.
  setTimeout(autoOphalen, 800);
});
// Breedte verandert bij draaien van het scherm: scroll opnieuw meten.
window.addEventListener('resize', () => requestAnimationFrame(zetScrollAan));
</script>
