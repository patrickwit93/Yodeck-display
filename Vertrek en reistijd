<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Trein en auto, Amstelland Ingenieurs</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --geel:    #FFC917;
      --rood:    #E4032D;
      --zwart:   #1D1D1B;
      --grijs-m: #8A8A88;
      --groen:   #4ec46a;
      --oranje:  #f0902a;
      --alarm:   #ff5a72;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }

    /* Liggend scherm: panelen naast elkaar. Staand scherm: onder elkaar.
       Lettergrootte schaalt mee met het vak. */
    html { background: var(--zwart); font-size: min(2.15vh, 1.55vw); }
    body {
      width: 100vw; height: 100vh; overflow: hidden;
      font-family: 'Montserrat', Arial, sans-serif;
      color: #fff; background: var(--zwart);
    }
    body { display: flex; flex-direction: column; }

    /* ══ BOVENBALK ═════════════════════════════════════════════════ */
    .balk {
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding: .9rem 1.6rem;
      background: #141413;
      border-bottom: .2rem solid var(--rood);
    }
    .balk .logo { height: 2.8rem; width: auto; display: block; overflow: visible; flex-shrink: 0; }
    .klok { display: flex; align-items: baseline; gap: 1.1rem; white-space: nowrap; }
    .klok-datum { font-size: .95rem; font-weight: 600; color: rgba(255,255,255,.65); }
    .klok-tijd { font-size: 2rem; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: .02em; }

    .scherm { flex: 1; min-height: 0; width: 100%; display: flex; flex-direction: row; gap: 1rem; padding: 1rem; }
    @media (orientation: portrait) {
      html { font-size: min(1.3vh, 2.6vw); }
      .scherm { flex-direction: column; }
    }

    /* ══ PANEEL ════════════════════════════════════════════════════ */
    .paneel {
      flex: 1; min-width: 0; min-height: 0;
      display: flex; flex-direction: column;
      padding: 1.2rem 1.1rem 1rem;
      border-radius: .6rem;
      background: rgba(255,255,255,.03);
      border-top: .4rem solid;
    }
    .paneel.trein { border-top-color: var(--geel); }
    .paneel.auto  { border-top-color: var(--rood); }

    .kop { display: flex; align-items: center; gap: .7rem; margin-bottom: 1rem; flex-shrink: 0; padding-bottom: .8rem; border-bottom: 2px solid rgba(255,255,255,.1); }
    .kop-icoon { width: 2.6rem; height: 2.6rem; border-radius: .5rem; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .kop-icoon svg { width: 60%; height: 60%; }
    .trein .kop-icoon { background: var(--geel); }
    .auto  .kop-icoon { background: var(--rood); }
    .kop-tekst { min-width: 0; }
    .kop-label { font-size: .6rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .trein .kop-label { color: var(--geel); }
    .auto  .kop-label { color: #ff3b5c; }
    .kop-titel { font-size: 1.05rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
    .kop-sub { font-size: .68rem; color: rgba(255,255,255,.5); font-weight: 600; margin-top: .1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .voet { flex-shrink: 0; margin-top: .7rem; text-align: right; }
    .stxt { font-size: .64rem; color: rgba(255,255,255,.35); font-weight: 500; }
    .stxt.fout { color: var(--alarm); }

    .laden-punt { width: .9rem; height: .9rem; flex-shrink: 0; border: .13rem solid rgba(255,255,255,.15); border-radius: 50%; animation: draaien .7s linear infinite; margin: .2rem 0; }
    .trein .laden-punt { border-top-color: var(--geel); }
    .auto  .laden-punt { border-top-color: var(--rood); }
    @keyframes draaien { to { transform: rotate(360deg); } }

    /* ══ TREIN ═════════════════════════════════════════════════════ */
    .col-head { display: grid; grid-template-columns: 1fr 3.4rem 4.6rem; padding: 0 .3rem; margin-bottom: .4rem; flex-shrink: 0; }
    .col-head span { font-size: .6rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.4); }
    .col-head span.c { text-align: center; }
    .col-head span.r { text-align: right; }

    .t-lijst { flex: 1; display: flex; flex-direction: column; min-height: 0; overflow-y: auto; scrollbar-width: none; }
    .t-lijst::-webkit-scrollbar { display: none; }

    .t-rij { flex: 0 0 auto; display: grid; grid-template-columns: 1fr 3.4rem 4.6rem; align-items: center; padding: .78rem .3rem; border-bottom: 1px solid rgba(255,255,255,.09); }
    .t-rij.x { opacity: .5; }

    .cell-dir { min-width: 0; padding: 0 .8rem 0 0; }
    .dir-naam-wrap { overflow: hidden; }
    .dir-naam { font-size: 1.4rem; font-weight: 700; white-space: nowrap; display: inline-block; }
    .dir-naam.geannuleerd { text-decoration: line-through; color: var(--grijs-m); }
    .dir-status { font-size: .78rem; font-weight: 700; color: var(--rood); text-transform: uppercase; letter-spacing: .02em; margin-top: .05rem; }
    .dir-status.rijdt-niet { color: var(--grijs-m); }

    .cell-spoor { display: flex; align-items: center; justify-content: center; }
    .spoor-chip { min-width: 2.1rem; text-align: center; background: var(--geel); color: #1a1a1a; border-radius: .3rem; padding: .22rem .3rem; font-size: 1.15rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .t-rij.x .spoor-chip { background: rgba(255,255,255,.15); color: rgba(255,255,255,.5); }

    .cell-tijd { display: flex; align-items: baseline; justify-content: flex-end; gap: .3rem; line-height: 1.1; }
    .tijd-nu { font-size: 1.7rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .tijd-nu.vertraagd { color: var(--rood); }
    .tijd-nu.geannuleerd { color: var(--grijs-m); text-decoration: line-through; }
    .tijd-unit { font-size: .72rem; font-weight: 700; color: rgba(255,255,255,.55); }

    /* ══ AUTO ══════════════════════════════════════════════════════ */
    .a-lijst { flex: 1; display: flex; flex-direction: column; gap: .45rem; min-height: 0; }
    .a-rij { flex: 1; display: flex; align-items: center; gap: .75rem; background: rgba(255,255,255,.05); border-left: .25rem solid #3a3a38; border-radius: .45rem; padding: 0 .8rem; min-height: 0; }
    .a-rij.g { border-left-color: var(--groen); }
    .a-rij.o { border-left-color: var(--oranje); }
    .a-rij.r { border-left-color: var(--alarm); }
    .a-info { min-width: 0; flex: 1; }
    .a-naam { font-size: 1.3rem; font-weight: 700; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .a-min { font-size: 1.3rem; font-weight: 800; letter-spacing: -.01em; white-space: nowrap; flex-shrink: 0; text-align: right; }
    .a-min .a-plus { font-size: .78rem; font-weight: 700; margin-left: .3rem; }
    .a-min.g { color: var(--groen); }
    .a-min.o { color: var(--oranje); }
    .a-min.r { color: var(--alarm); }
    .a-min.gr { color: rgba(255,255,255,.3); font-size: 1rem; }
  </style>
</head>
